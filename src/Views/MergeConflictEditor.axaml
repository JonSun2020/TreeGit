<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:m="using:SourceGit.Models"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:c="using:SourceGit.Converters"
                    mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
                    x:Class="SourceGit.Views.MergeConflictEditor"
                    x:DataType="vm:MergeConflictEditor"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.MergeConflictEditor.Title}"
                    MinWidth="1024" MinHeight="600">
  <Grid RowDefinitions="Auto,32,*,32">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              DoubleTapped="MaximizeOrRestoreWindow"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="12" Height="12"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Conflict}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.MergeConflictEditor.Title}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right" IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <!-- The navigation starts at the Remote column. -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.ToolBar}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}">
      <Grid ColumnDefinitions="*,*,*" Margin="4,0,24,0">
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Margin="8,0">
          <Path Width="14" Height="14" Data="{StaticResource Icons.File}"/>
          <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding FilePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <StackPanel Grid.Column="2" x:Name="ConflictNavigation" Orientation="Horizontal" Margin="2,0,0,0" VerticalAlignment="Center" Spacing="4">
          <Button x:Name="PreviousConflict" Classes="icon_button" Width="28" Height="28"
                  ToolTip.Tip="{DynamicResource Text.MergeConflictEditor.PrevConflict}" Click="OnGotoPrevConflict"
                  HotKey="{OnPlatform Ctrl+Up, macOS=?+Up}"
                  IsEnabled="{Binding TotalConflictCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Up}"/>
          </Button>
          <Button x:Name="NextConflict" Classes="icon_button" Width="28" Height="28"
                  ToolTip.Tip="{DynamicResource Text.MergeConflictEditor.NextConflict}" Click="OnGotoNextConflict"
                  HotKey="{OnPlatform Ctrl+Down, macOS=?+Down}"
                  IsEnabled="{Binding TotalConflictCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Down}"/>
          </Button>
          <Button x:Name="UndoMergeResult" Classes="icon_button" Width="28" Height="28" Click="OnUndoResult"
                  ToolTip.Tip="{DynamicResource Text.MergeConflictEditor.UndoEdit}" IsEnabled="{Binding ResultDocument.UndoStack.CanUndo}">
            <Path Width="18" Height="12" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource Brush.FG1}" StrokeThickness="1.5"
                  StrokeLineCap="Round" StrokeJoin="Round" Data="M 20,13 A 8,8 0 0 0 4,13 M 0.5,9.5 L 4,13 L 7.5,9.5"/>
          </Button>
          <TextBlock x:Name="ConflictPosition" Margin="4,0" Text="{Binding ConflictPosition}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding UnsolvedCount, Converter={x:Static c:IntConverters.ToUnsolvedDesc}}" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Content -->
    <Grid x:Name="ConflictContent" Grid.Row="2" ColumnDefinitions="*,20" IsEnabled="{Binding !IsSaving}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="110"/>
        <RowDefinition Height="4"/>
        <RowDefinition Height="*" MinHeight="140"/>
      </Grid.RowDefinitions>
      <!-- Mine and Theirs Panels (Side-by-Side) -->
      <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,*,*" Margin="4,4,4,2" IsVisible="{Binding HasComparison}">
        <!-- Mine (Ours) Panel -->
        <Border Grid.Column="0" Margin="0,0,2,0">
          <Grid RowDefinitions="26,*">
            <Border Grid.Row="0" Padding="8,0" ClipToBounds="True" Background="{DynamicResource Brush.Popup}" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource Brush.Border2}">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                           Text="Local"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <ContentControl Grid.Column="1" Margin="8,0,0,0" Content="{Binding Mine, Mode=OneWay}">
                  <ContentControl.DataTemplates>
                    <DataTemplate DataType="m:Commit">
                      <StackPanel Orientation="Horizontal">
                        <v:CommitRefsPresenter Foreground="{DynamicResource Brush.FG1}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               UseGraphColor="False"/>
                        <TextBlock Margin="4,0,0,0"
                                   FontFamily="{DynamicResource Fonts.Monospace}"
                                   Text="{Binding SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                                   Foreground="DarkOrange"
                                   TextDecorations="Underline"
                                   Cursor="Hand"/>
                        <TextBlock Margin="4,0,0,0" Text="{Binding Subject}"/>
                      </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="x:String">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Data="{StaticResource Icons.Changes}"/>
                        <TextBlock Margin="4,0,0,0" Text="{Binding}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>
              </Grid>
            </Border>
            <Grid Grid.Row="1" Background="{DynamicResource Brush.Contents}">
              <v:MergeConflictTextPresenter x:Name="OursPresenter"
                                            PanelType="Ours"
                                            Lines="{Binding OursLines, Mode=OneWay}"
                                            MaxLineNumber="{Binding MaxLineNumber}"
                                            FileName="{Binding FilePath}"
                                            FontFamily="{DynamicResource Fonts.Monospace}"
                                            TheirsContentBackground="{DynamicResource Brush.Conflict.TheirsBG}"
                                            OursContentBackground="{DynamicResource Brush.Conflict.MineBG}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Border2}"/>
            </Grid>
          </Grid>
        </Border>

        <!-- The immutable index-stage ancestor, aligned with Local and Remote. -->
        <Border Grid.Column="1" Margin="2,0">
          <Grid RowDefinitions="26,*">
            <Border Grid.Row="0" Padding="8,0" ClipToBounds="True" Background="{DynamicResource Brush.Popup}" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource Brush.Border2}">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Base" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding BaseHint}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <v:MergeConflictTextPresenter x:Name="BasePresenter" Grid.Row="1" PanelType="Base"
                                          Lines="{Binding BaseLines}" MaxLineNumber="{Binding MaxLineNumber}"
                                          FileName="{Binding FilePath}" FontFamily="{DynamicResource Fonts.Monospace}"
                                          BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"/>
          </Grid>
        </Border>

        <!-- Theirs Panel -->
        <Border x:Name="TheirsPanel" Grid.Column="2" Margin="2,0,0,0">
          <Grid RowDefinitions="26,*">
            <Border Grid.Row="0" Padding="8,0" ClipToBounds="True" Background="{DynamicResource Brush.Popup}" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource Brush.Border2}">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                           Text="Remote"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <ContentControl Grid.Column="1" Margin="8,0,0,0" Content="{Binding Theirs, Mode=OneWay}">
                  <ContentControl.DataTemplates>
                    <DataTemplate DataType="m:Commit">
                      <StackPanel Orientation="Horizontal">
                        <v:CommitRefsPresenter Foreground="{DynamicResource Brush.FG1}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               UseGraphColor="False"/>
                        <TextBlock Margin="4,0,0,0"
                                   FontFamily="{DynamicResource Fonts.Monospace}"
                                   Text="{Binding SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                                   Foreground="DarkOrange"
                                   TextDecorations="Underline"
                                   Cursor="Hand"/>
                        <TextBlock Margin="4,0,0,0" Text="{Binding Subject}"/>
                      </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="x:String">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Data="{StaticResource Icons.Changes}"/>
                        <TextBlock Margin="4,0,0,0" Text="{Binding}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>
              </Grid>
            </Border>
            <Grid Grid.Row="1" Background="{DynamicResource Brush.Contents}">
              <v:MergeConflictTextPresenter x:Name="TheirsPresenter"
                                            PanelType="Theirs"
                                            Lines="{Binding TheirsLines, Mode=OneWay}"
                                            MaxLineNumber="{Binding MaxLineNumber}"
                                            FileName="{Binding FilePath}"
                                            FontFamily="{DynamicResource Fonts.Monospace}"
                                            TheirsContentBackground="{DynamicResource Brush.Conflict.TheirsBG}"
                                            OursContentBackground="{DynamicResource Brush.Conflict.MineBG}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Border2}"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Row="1" Grid.Column="0" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" IsVisible="{Binding HasComparison}"/>
      <!-- The result is a real editable document, not the aligned comparison rows. -->
      <Border Grid.Row="2" Grid.Column="0" Margin="4,2,4,4">
        <Grid RowDefinitions="32,*">
          <Border Grid.Row="0" Padding="8,0" ClipToBounds="True" Background="{DynamicResource Brush.Popup}" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource Brush.Border2}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource Text.MergeConflictEditor.EditableResult}" FontWeight="Bold" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" Width="125" Margin="8,0,0,0" ItemsSource="{Binding EncodingChoices}" SelectedItem="{Binding SelectedEncoding, Mode=TwoWay}" IsEnabled="{Binding CanChangeEncoding}" ToolTip.Tip="{DynamicResource Text.MergeConflictEditor.EncodingHint}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="m:MergeConflictEncoding"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
          <v:MergeResultEditor x:Name="ResultPresenter" Grid.Row="1" Document="{Binding ResultDocument}" FileName="{Binding FilePath}" FontFamily="{DynamicResource Fonts.Monospace}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"/>
        </Grid>
      </Border>

      <!-- Minimap -->
      <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
              Margin="0,4,4,4"
              BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}">
        <v:MergeConflictMinimap DisplayRange="{Binding #OursPresenter.DisplayRange, Mode=OneWay}"
                                UnsolvedCount="{Binding UnsolvedCount, Mode=OneWay}"/>
      </Border>
    </Grid>

    <!-- Error -->
    <Border Grid.Row="2"
            Background="{DynamicResource Brush.Popup}"
            BorderThickness="1" BorderBrush="{DynamicResource Brush.PopupBorder}"
            Padding="16"
            CornerRadius="6"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Effect="drop-shadow(0 0 12 #60000000)"
            IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Orientation="Vertical">
        <Path Width="32" Height="32" Fill="Orange" Data="{StaticResource Icons.Error}"/>
        <TextBlock Text="{Binding Error, Mode=OneWay}"
                   MaxWidth="500"
                   Margin="0,16"
                   TextWrapping="Wrap"/>
        <Button Classes="flat primary"
                MinWidth="80"
                Margin="0"
                HorizontalAlignment="Center"
                Content="{DynamicResource Text.Sure}"
                Command="{Binding ClearErrorMessage}"
                HotKey="Escape"/>
      </StackPanel>
    </Border>

    <!-- Foot -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="8">
      <Button x:Name="SaveMergeResult" Classes="flat primary"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              HotKey="{OnPlatform Ctrl+S, macOS=⌘+S}"
              Click="OnSaveAndStage"
              IsEnabled="{Binding CanSave}">
        <TextBlock Text="{DynamicResource Text.MergeConflictEditor.SaveAndStage}"/>
      </Button>

      <Button x:Name="CancelMergeEditor" Classes="flat" IsEnabled="{Binding !IsSaving}"
              Width="80"
              Content="{DynamicResource Text.Cancel}"
              Click="CloseWindow"
              HorizontalAlignment="Center"/>
    </StackPanel>
  </Grid>
</v:ChromelessWindow>
