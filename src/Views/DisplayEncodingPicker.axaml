<v:CompactComboBox xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:m="using:SourceGit.Models" xmlns:v="using:SourceGit.Views"
          x:Class="SourceGit.Views.DisplayEncodingPicker" Padding="3,0"
          ItemsSource="{x:Static m:DisplayEncodingOption.Supported}"
          AutomationProperties.Name="{DynamicResource Text.UI.DisplayEncoding}">
  <v:CompactComboBox.Resources>
    <DataTemplate x:Key="EncodingCaption" x:DataType="m:DisplayEncodingOption">
      <TextBlock Text="{Binding Name}" Margin="1,0" HorizontalAlignment="Left" TextAlignment="Left"/>
    </DataTemplate>
  </v:CompactComboBox.Resources>
  <v:CompactComboBox.ItemTemplate>
    <StaticResource ResourceKey="EncodingCaption"/>
  </v:CompactComboBox.ItemTemplate>
  <v:CompactComboBox.SelectionBoxItemTemplate>
    <DataTemplate x:DataType="m:DisplayEncodingOption">
      <Panel>
        <ItemsControl ItemsSource="{x:Static m:DisplayEncodingOption.Supported}" ItemTemplate="{StaticResource EncodingCaption}"
                      Opacity="0" IsHitTestVisible="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><Panel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock x:Name="SelectedEncodingText" Text="{Binding Name}" Margin="1,0" HorizontalAlignment="Left" TextAlignment="Left"/>
      </Panel>
    </DataTemplate>
  </v:CompactComboBox.SelectionBoxItemTemplate>
</v:CompactComboBox>
