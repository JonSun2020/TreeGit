<ComboBox xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          x:Class="SourceGit.Views.DisplayEncodingPicker" MinWidth="128"
          AutomationProperties.Name="{DynamicResource Text.UI.DisplayEncoding}">
  <ComboBoxItem Content="{DynamicResource Text.UI.AutoEncoding}"/>
  <ComboBoxItem Content="UTF-8"/>
  <ComboBoxItem Content="UTF-16 LE"/>
  <ComboBoxItem Content="UTF-16 BE"/>
  <ComboBoxItem Content="UTF-32 LE"/>
  <ComboBoxItem Content="UTF-32 BE"/>
  <ComboBoxItem Content="GB2312"/>
  <ComboBoxItem Content="GBK"/>
  <ComboBoxItem Content="GB18030"/>
  <ComboBoxItem Content="Big5"/>
  <ComboBoxItem Content="Windows-1252"/>
</ComboBox>
