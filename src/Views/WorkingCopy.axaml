<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:SourceGit.ViewModels" xmlns:v="using:SourceGit.Views" xmlns:c="using:SourceGit.Converters" xmlns:m="using:SourceGit.Models" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600" x:Class="SourceGit.Views.WorkingCopy" x:DataType="vm:WorkingCopy" x:Name="ThisControl" Classes.overview="{Binding #ThisControl.IsOverview}">
  <UserControl.Styles>
    <Style Selector="v|WorkingCopy.overview Border#DiffToolbar"><Setter Property="Padding" Value="0,0,28,0"/></Style>
    <Style Selector="CheckBox.commit_option /template/ ContentPresenter#ContentPresenter">
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
  </UserControl.Styles>
  <v:SplitViewGrid x:Name="MainLayout" SizeChanged="OnMainLayoutSizeChanged" Background="{DynamicResource Brush.SubPanel}" >
    <v:SplitViewGrid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="265"/>
      <RowDefinition Height="4"/>
      <RowDefinition Height="128" MinHeight="80"/>
      <RowDefinition Height="Auto" MinHeight="40"/>
    </v:SplitViewGrid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding Repository.ChangesPanelWidth, Mode=TwoWay}" MinWidth="300"/>
      <ColumnDefinition Width="4"/>
      <ColumnDefinition Width="*" MinWidth="470"/>
    </Grid.ColumnDefinitions>

    <!-- Left -->
    <Grid Grid.Column="0" Background="{DynamicResource Brush.Window}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="100"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="*" MinHeight="100"/>
      </Grid.RowDefinitions>

      <!-- Change list controls -->
      <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
        <Grid x:Name="LocalChangesToolbar" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="2" Margin="2,1,0,1">
          <ComboBox x:Name="ChangeStatusFilterBox" Grid.Column="0" Height="24" MinHeight="24" MinWidth="0" Padding="3,0"
                    VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                    SelectedIndex="{Binding ChangeStatusFilter, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Text.UI.FilterStatus}"
                    ItemsSource="{x:Static m:ChangeListOptions.StatusFilters}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="m:ChangeListOption">
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="m:ChangeListOption">
                <Panel>
                  <Panel Margin="2,0" Opacity="0" IsHitTestVisible="False">
                    <TextBlock Text="{DynamicResource Text.UI.AllChanges}"/>
                    <TextBlock Text="{DynamicResource Text.UI.Conflicts}"/>
                    <TextBlock Text="{DynamicResource Text.UI.Modified}"/>
                    <TextBlock Text="{DynamicResource Text.UI.Untracked}"/>
                  </Panel>
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Panel>
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
          <ComboBox x:Name="ChangeSortOrderBox" Grid.Column="1" Height="24" MinHeight="24" MinWidth="0" Padding="3,0"
                    VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                    SelectedIndex="{Binding ChangeSortOrder, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Text.UI.SortOrder}"
                    ItemsSource="{x:Static m:ChangeListOptions.SortOrders}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="m:ChangeListOption">
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="m:ChangeListOption">
                <Panel>
                  <Panel Margin="2,0" Opacity="0" IsHitTestVisible="False">
                    <TextBlock Text="{DynamicResource Text.UI.SortPath}"/>
                    <TextBlock Text="{DynamicResource Text.UI.SortName}"/>
                    <TextBlock Text="{DynamicResource Text.UI.SortStatus}"/>
                  </Panel>
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Panel>
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
          <v:ChangeViewModeSwitcher Grid.Column="2" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    ViewMode="{Binding Source={x:Static vm:Preferences.Instance}, Path=ChangeViewMode, Mode=TwoWay}"/>
        </Grid>
      </Border>

      <!-- Unstaged -->
      <Grid Grid.Row="3" RowDefinitions="Auto,*">
        <!-- Unstaged Toolbar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}" MinHeight="28">
          <v:RightAlignedWrapPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <Path Margin="8,0,0,0" Width="14" Height="14" Fill="{DynamicResource Brush.FG2}" Data="{StaticResource Icons.Changes}"/>
              <TextBlock Foreground="{DynamicResource Brush.FG2}" FontWeight="Bold" Margin="4,0,0,0">
                <Run Text="{DynamicResource Text.TreeGit.Changes.Unstaged}"/>
                <Run Text="{Binding UnstagedCountInfo, Mode=OneWay}"/>
              </TextBlock>
              <v:LoadingIcon Width="14" Height="14" Margin="8,0,0,0" IsVisible="{Binding IsStaging}"/>
            </StackPanel>
            <Button Classes="icon_button" Width="26" Height="14" Padding="0" ToolTip.Tip="{DynamicResource Text.WorkingCopy.Unstaged.ViewAssumeUnchanged}" Click="OnOpenAssumeUnchanged" Margin="3,2">
              <Path Width="14" Height="14" Data="{StaticResource Icons.File.Ignore}"/>
            </Button>
            <ToggleButton Classes="toggle_untracked" Width="26" Height="14" ToolTip.Tip="{DynamicResource Text.WorkingCopy.IncludeUntracked}" IsChecked="{Binding IncludeUntracked, Mode=TwoWay}" Margin="3,2"/>
            <Button Classes="icon_button" Width="26" Height="14" Padding="0" IsVisible="{Binding HasUnsolvedConflicts}" ToolTip.Tip="{DynamicResource Text.WorkingCopy.Conflicts.OpenExternalMergeToolAllConflicts}" Click="OnOpenExternalMergeToolAllConflicts" Margin="3,2">
              <Path Width="14" Height="14" Data="{StaticResource Icons.Conflict}"/>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="3,2">
              <Button Classes="flat treegit_stage_action" Width="110" Height="20" Padding="4,0" HotKey="{OnPlatform Ctrl+Shift+S, macOS=⌘+Shift+S}" x:Name="StageAllChanges" Click="OnStageAllButtonClicked" FontSize="11">
                <Button.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="CanChangeIndex"/><Binding Path="VisibleUnstaged.Count" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/></MultiBinding></Button.IsEnabled>
                <ToolTip.Tip>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Unstaged.StageAll}" VerticalAlignment="Center"/>
                    <TextBlock Margin="16,0,0,0" Text="{OnPlatform Ctrl+Shift+S, macOS=⌘+⇧+S}" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}" FontSize="11" VerticalAlignment="Center"/>
                  </StackPanel>
                </ToolTip.Tip>
                <TextBlock Text="{DynamicResource Text.TreeGit.Changes.StageAll}"/>
              </Button>
              <Button Classes="flat treegit_stage_action" Width="110" Height="20" Padding="4,0" x:Name="StageSelectedChanges" Click="OnStageSelectedButtonClicked" FontSize="11">
                <Button.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="CanChangeIndex"/><Binding Path="SelectedUnstaged.Count" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/></MultiBinding></Button.IsEnabled>
                <ToolTip.Tip>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Unstaged.Stage}" VerticalAlignment="Center"/>
                    <TextBlock Margin="16,0,0,0" Text="{OnPlatform Space/Enter, macOS=␣/Enter}" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}" FontSize="11" VerticalAlignment="Center"/>
                  </StackPanel>
                </ToolTip.Tip>
                <TextBlock Text="{DynamicResource Text.TreeGit.Changes.StageSelected}"/>
              </Button>
            </StackPanel>
          </v:RightAlignedWrapPanel>
        </Border>

        <!-- Unstaged Changes -->
        <v:ChangeCollectionView Grid.Row="1" x:Name="UnstagedChangesView" PreserveChangeOrder="True" IsUnstagedChange="True" Background="{DynamicResource Brush.Contents}" ViewMode="{Binding Source={x:Static vm:Preferences.Instance}, Path=ChangeViewMode}" EnableCompactFolders="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableCompactFoldersInChangesTree}" Changes="{Binding VisibleUnstaged}" Selection="{Binding SelectedUnstaged, Mode=TwoWay}" ContextRequested="OnUnstagedContextRequested" ChangeDoubleTapped="OnUnstagedChangeDoubleTapped" KeyDown="OnUnstagedKeyDown"/>
      </Grid>

      <!-- Splitter -->
      <GridSplitter Grid.Row="2" MinHeight="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Brush.Border0}" Focusable="False"/>

      <!-- Staged -->
      <Grid Grid.Row="1" RowDefinitions="Auto,*">
        <!-- Staged Toolbar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}" MinHeight="28">
          <v:RightAlignedWrapPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <Path Margin="8,0,0,0" Width="14" Height="14" Fill="{DynamicResource Brush.FG2}" Data="{StaticResource Icons.Changes}"/>
              <TextBlock Foreground="{DynamicResource Brush.FG2}" FontWeight="Bold" Margin="4,0,0,0">
                <Run Text="{DynamicResource Text.TreeGit.Changes.Staged}"/>
                <Run Text="{Binding StagedCountInfo, Mode=OneWay}"/>
              </TextBlock>
              <v:LoadingIcon Width="14" Height="14" Margin="8,0,0,0" IsVisible="{Binding IsUnstaging}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="3,2">
              <Button Classes="flat treegit_stage_action" Width="110" Height="20" Padding="4,0" HotKey="{OnPlatform Ctrl+Shift+U, macOS=⌘+Shift+U}" x:Name="UnstageAllChanges" Click="OnUnstageAllButtonClicked" FontSize="11">
                <Button.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="CanChangeIndex"/><Binding Path="VisibleStaged.Count" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/></MultiBinding></Button.IsEnabled>
                <ToolTip.Tip>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Staged.UnstageAll}" VerticalAlignment="Center"/>
                    <TextBlock Margin="16,0,0,0" Text="{OnPlatform Ctrl+Shift+U, macOS=⌘+⇧+U}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
                  </StackPanel>
                </ToolTip.Tip>
                <TextBlock Text="{DynamicResource Text.TreeGit.Changes.UnstageAll}"/>
              </Button>
              <Button Classes="flat treegit_stage_action" Width="110" Height="20" Padding="4,0" x:Name="UnstageSelectedChanges" Click="OnUnstageSelectedButtonClicked" FontSize="11">
                <Button.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="CanChangeIndex"/><Binding Path="SelectedStaged.Count" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/></MultiBinding></Button.IsEnabled>
                <ToolTip.Tip>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Staged.Unstage}" VerticalAlignment="Center"/>
                    <TextBlock Margin="16,0,0,0" Text="{OnPlatform Space/Enter, macOS=␣/Enter}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
                  </StackPanel>
                </ToolTip.Tip>
                <TextBlock Text="{DynamicResource Text.TreeGit.Changes.UnstageSelected}"/>
              </Button>
            </StackPanel>
          </v:RightAlignedWrapPanel>
        </Border>

        <!-- Staged Changes -->
        <v:ChangeCollectionView Grid.Row="1" x:Name="StagedChangesView" PreserveChangeOrder="True" IsUnstagedChange="False" Background="{DynamicResource Brush.Contents}" ViewMode="{Binding Source={x:Static vm:Preferences.Instance}, Path=ChangeViewMode}" EnableCompactFolders="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableCompactFoldersInChangesTree}" Changes="{Binding VisibleStaged}" Selection="{Binding SelectedStaged, Mode=TwoWay}" ContextRequested="OnStagedContextRequested" ChangeDoubleTapped="OnStagedChangeDoubleTapped" KeyDown="OnStagedKeyDown"/>
      </Grid>
    </Grid>

    <GridSplitter Grid.Column="1" MinWidth="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Brush.Border0}" Focusable="False"/>

    <!-- Right -->
    <Grid Grid.Column="2" Margin="4,4,6,0">
      

      <!-- Select Change Detail -->
      <Grid Grid.Row="0">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="OverviewEmptyHint">
          <Path Width="32" Height="32" Data="{StaticResource Icons.Diff}" Fill="{DynamicResource Brush.FG2}"/>
          <TextBlock Margin="0,16,0,0" Text="{DynamicResource Text.Diff.Welcome}" FontSize="13" Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Center"/>
        </StackPanel>

        <ContentControl Content="{Binding DetailContext}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:Conflict">
              <v:Conflict/>
            </DataTemplate>

            <DataTemplate DataType="vm:DiffContext">
              <v:DiffView/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Grid>

      <!-- Splitter -->
      

      <!-- Commit Message -->
      

      <!-- Commit Options -->
      
    </Grid>
  <GridSplitter Grid.Row="1" MinHeight="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Focusable="False" Grid.ColumnSpan="3"/>
  <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="8,0" RowDefinitions="28,*">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
      <Grid Margin="0,0,8,0">
        <TextBlock x:Name="CommitIdentityLabel" Text="{Binding CommitterIdentity}" IsVisible="{Binding HasCommitterIdentity}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding CommitterIdentity}"/>
        <TextBlock Text="{DynamicResource Text.TreeGit.Commit.IdentityLoading}" Foreground="{DynamicResource Brush.FG2}" VerticalAlignment="Center">
          <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="HasCommitterIdentity" Converter="{x:Static BoolConverters.Not}"/><Binding Path="IsCommitterIdentityLoading"/></MultiBinding></TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Text="{DynamicResource Text.TreeGit.Commit.IdentityMissing}" Foreground="{DynamicResource Brush.FG2}" VerticalAlignment="Center">
          <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="HasCommitterIdentity" Converter="{x:Static BoolConverters.Not}"/><Binding Path="IsCommitterIdentityLoading" Converter="{x:Static BoolConverters.Not}"/></MultiBinding></TextBlock.IsVisible>
        </TextBlock>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding UseAmend}" Margin="4,0,12,0">
        <TextBlock Text="{DynamicResource Text.WorkingCopy.Amend}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Classes="icon_button" Width="18" Height="20" Padding="3" Click="OnCancelAmend" ToolTip.Tip="{DynamicResource Text.Cancel}"><Path Width="9" Height="9" Data="{StaticResource Icons.Close}"/></Button>
      </StackPanel>
      <TextBlock x:Name="CommitBranchLabel" Grid.Column="2" Text="{Binding CommitBranchDisplay}" ToolTip.Tip="{Binding CommitBranchDisplay}" MaxWidth="260" Margin="8,0,10,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <Button Grid.Column="3" x:Name="RecentCommitMessagesButton" Classes="flat" Width="28" Height="24" Padding="0" Click="OnOpenRecentCommitMessages" ToolTip.Tip="{DynamicResource Text.TreeGit.Commit.History.Button}">
        <Button.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="HasStagedFiles"/><Binding Path="CanChangeIndex"/></MultiBinding></Button.IsEnabled>
        <Path Width="16" Height="16" Data="{StaticResource Icons.CommitMessageHistory}"/>
      </Button>
    </Grid>
    <Grid Grid.Row="1">
      <v:CommitMessageToolBox x:Name="InlineCommitMessage" ShowAdvancedOptions="True" ShowToolbar="False" ShowSubjectGuide="False" CommitMessage="{Binding CommitMessage, Mode=TwoWay}">
        <v:CommitMessageToolBox.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="HasStagedFiles"/><Binding Path="CanChangeIndex"/></MultiBinding></v:CommitMessageToolBox.IsEnabled>
      </v:CommitMessageToolBox>
      <Border x:Name="NoStagedFilesMask" Background="{DynamicResource Brush.Window}" Opacity="0.8" IsVisible="{Binding !HasStagedFiles}" CornerRadius="4">
        <TextBlock x:Name="NoStagedFilesLabel" Text="{DynamicResource Text.TreeGit.Commit.NoStagedFiles}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Brush.FG2}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
      </Border>
    </Grid>
  </Grid>
  <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="8,0" ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
      <CheckBox x:Name="SkipCommitHooksCheckBox" Classes="commit_option" IsChecked="{Binding NoVerifyOnCommit, Mode=TwoWay}" IsEnabled="{Binding CanChangeIndex}" MinHeight="24"><TextBlock Text="{DynamicResource Text.TreeGit.Commit.SkipHooks}" Foreground="{Binding #SkipCommitHooksCheckBox.Foreground}"/></CheckBox>
      <v:CommitOptionSeparator VerticalAlignment="Center" Opacity="0.7"/>
      <CheckBox x:Name="SignOffCheckBox" Classes="commit_option" IsChecked="{Binding EnableSignOff, Mode=TwoWay}" IsEnabled="{Binding CanChangeIndex}" MinHeight="24"><TextBlock Text="{DynamicResource Text.WorkingCopy.SignOff}" Foreground="{Binding #SignOffCheckBox.Foreground}"/></CheckBox>
      <StackPanel Orientation="Horizontal">
        <StackPanel.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="HasRemotes"/><Binding Path="UseAmend" Converter="{x:Static BoolConverters.Not}"/><Binding Path="InProgressContext" Converter="{x:Static ObjectConverters.IsNull}"/></MultiBinding></StackPanel.IsVisible>
        <v:CommitOptionSeparator VerticalAlignment="Center" Opacity="0.7"/>
        <CheckBox x:Name="PushImmediatelyCheckBox" Classes="commit_option" IsChecked="{Binding PushAfterCommit, Mode=TwoWay}" IsEnabled="{Binding CanChangeIndex}" MinHeight="24"><TextBlock Text="{Binding PushAfterCommitText}" Foreground="{Binding #PushImmediatelyCheckBox.Foreground}"/></CheckBox>
      </StackPanel>
    </WrapPanel>
    <v:LoadingIcon Grid.Column="1" Width="18" Height="18" IsVisible="{Binding IsCommitting}"/>
        <SplitButton Grid.Column="2" Content="{DynamicResource Text.Repository.Continue}" Height="28" Margin="8,0,0,0" Padding="8,0" Click="OnContinue" IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNotNull}}">
          <SplitButton.Styles>
            <Style Selector="SplitButton">
              <Setter Property="MinHeight" Value="24"/>
              <Setter Property="Template">
                <ControlTemplate>
                  <Grid ColumnDefinitions="*,1,Auto">
                    <Button x:Name="PART_PrimaryButton" Grid.Column="0" Classes="flat primary" MinWidth="32" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Command="{TemplateBinding Command}" CommandParameter="{TemplateBinding CommandParameter}" CornerRadius="3,0,0,3" Padding="{TemplateBinding Padding}" Focusable="False" KeyboardNavigation.IsTabStop="False"/>

                    <Button x:Name="PART_SecondaryButton" Grid.Column="2" Classes="flat primary" Width="32" CornerRadius="0,3,3,0" Padding="0" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" KeyboardNavigation.IsTabStop="False">
                      <Path Height="12" Width="12" Margin="0,4,0,0" Fill="{DynamicResource AccentButtonForeground}" Data="{DynamicResource Icons.Down}"/>
                    </Button>
                  </Grid>
                </ControlTemplate>
              </Setter>

              <Style Selector="^:disabled /template/ Button">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
                <Setter Property="Background" Value="Transparent"/>
              </Style>

              <Style Selector="^:disabled AccessText">
                <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
              </Style>

              <Style Selector="^:disabled Path">
                <Setter Property="Fill" Value="{DynamicResource Brush.FG2}"/>
              </Style>
            </Style>
          </SplitButton.Styles>

          <SplitButton.IsEnabled>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="CanChangeIndex"/>
              <Binding Path="HasUnsolvedConflicts" Converter="{x:Static BoolConverters.Not}"/>
            </MultiBinding>
          </SplitButton.IsEnabled>
          <SplitButton.Flyout>
            <MenuFlyout>
              <MenuItem Header="{DynamicResource Text.WorkingCopy.CommitToEdit}" Click="OnCommit" IsEnabled="{Binding CommitMessage, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"/>
            </MenuFlyout>
          </SplitButton.Flyout>
        </SplitButton>
        <Button x:Name="CommitStagedButton" Grid.Column="2" Classes="flat primary" Content="{DynamicResource Text.WorkingCopy.Commit}" Height="28" Margin="8,0,0,0" Padding="8,0" Click="OnCommit" HotKey="{OnPlatform Ctrl+Enter, macOS=⌘+Enter}" IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNull}}" ToolTip.Placement="Top" ToolTip.VerticalOffset="0">
          <ToolTip.Tip>
            <StackPanel Orientation="Vertical">
              <TextBlock TextAlignment="Left" TextWrapping="Wrap">
                <Run Text="{OnPlatform Ctrl+Enter, macOS=⌘+Enter}"/>
                <Run Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.WorkingCopy.CommitTip}"/>
              </TextBlock>
              <TextBlock TextAlignment="Left" TextWrapping="Wrap" Margin="0,4,0,0">
                <Run Text="{OnPlatform Ctrl+Shift+Enter, macOS=⌘+⇧+Enter}"/>
                <Run Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.WorkingCopy.CommitWithAutoStage}"/>
              </TextBlock>
            </StackPanel>
          </ToolTip.Tip>

          <Button.Styles>
            <Style Selector="Button.flat.primary:disabled"><Setter Property="Background" Value="{DynamicResource Brush.Border1}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/><Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/></Style>
            <Style Selector="Button.flat.primary:disabled /template/ Border#PART_Border"><Setter Property="Background" Value="{DynamicResource Brush.Border1}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/></Style>
            <Style Selector="Button.flat.primary:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/></Style>
          </Button.Styles>
          <Button.IsEnabled>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="CanChangeIndex"/><Binding Path="HasStagedFiles"/><Binding Path="HasUnsolvedConflicts" Converter="{x:Static BoolConverters.Not}"/>
              <Binding Path="CommitMessage" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
            </MultiBinding>
          </Button.IsEnabled>
        </Button>
        <Button x:Name="CommitWithAutoStageHotkey" Grid.Column="2" Width="0" Height="0" Background="Transparent" Click="OnCommitWithAutoStage" HotKey="{OnPlatform Ctrl+Shift+Enter, macOS=⌘+Shift+Enter}">
          <Button.IsEnabled>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="CanChangeIndex"/><Binding Path="HasStagedFiles"/><Binding Path="HasUnsolvedConflicts" Converter="{x:Static BoolConverters.Not}"/>
              <Binding Path="CommitMessage" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
            </MultiBinding>
          </Button.IsEnabled>
        </Button>
        <Button x:Name="CommitWithPushButton" Grid.Column="2" Classes="flat" Content="{DynamicResource Text.WorkingCopy.CommitAndPush}" Width="0" Height="0" Margin="8,0,0,0" Padding="8,0" Click="OnCommitWithPush" HotKey="{OnPlatform Ctrl+Alt+Enter, macOS=⌘+Alt+Enter}" ToolTip.Tip="{OnPlatform Ctrl+Alt+Enter, macOS=⌘+⌥+Enter}" ToolTip.Placement="Top" ToolTip.VerticalOffset="0">
          <Button.IsEnabled>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="CanChangeIndex"/><Binding Path="HasStagedFiles"/><Binding Path="HasUnsolvedConflicts" Converter="{x:Static BoolConverters.Not}"/>
              <Binding Path="CommitMessage" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
            </MultiBinding>
          </Button.IsEnabled>

          <Button.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="HasRemotes"/>
              <Binding Path="UseAmend" Converter="{x:Static BoolConverters.Not}"/>
              <Binding Path="InProgressContext" Converter="{x:Static ObjectConverters.IsNull}"/>
            </MultiBinding>
          </Button.IsVisible>
        </Button>
  </Grid>
  </v:SplitViewGrid>
</UserControl>
