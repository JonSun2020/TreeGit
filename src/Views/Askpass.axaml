<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:v="using:SourceGit.Views"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                    x:Class="SourceGit.Views.Askpass"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.Askpass}"
                    SizeToContent="WidthAndHeight"
                    CanResize="False"
                    ShowActivated="True"
                    WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Password}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock x:Name="TxtTitle" Classes="bold"
                 Text="{DynamicResource Text.Askpass}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <Grid Grid.Row="1" Margin="0,16" RowDefinitions="*,Auto">
    <StackPanel x:Name="CredentialFields" Grid.Row="0" Orientation="Vertical">
      <Border x:Name="PromptDescription" Margin="16,0,16,12">
        <TextBlock x:Name="TxtDescription" MaxWidth="480" Text="{DynamicResource Text.Askpass.Passphrase}" TextWrapping="Wrap"/>
      </Border>

      <Grid Margin="16,0,16,16" MaxWidth="480" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
        <TextBlock x:Name="RepositoryLabel" IsVisible="False" Grid.Row="0" Grid.Column="0" Margin="0,0,8,6"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Text="{DynamicResource Text.TreeGit.Credentials.RepositoryCaption}"/>
        <TextBlock x:Name="TxtRepository" IsVisible="{Binding #RepositoryLabel.IsVisible}" Grid.Row="0" Grid.Column="1"
                   Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBlock x:Name="ServerLabel" IsVisible="{Binding #RepositoryLabel.IsVisible}" Grid.Row="1" Grid.Column="0" Margin="0,0,8,6"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Text="{DynamicResource Text.TreeGit.Credentials.ServerCaption}"/>
        <TextBlock x:Name="TxtServer" IsVisible="{Binding #RepositoryLabel.IsVisible}" Grid.Row="1" Grid.Column="1"
                   Margin="0,0,0,6" TextWrapping="Wrap"/>

        <TextBlock x:Name="UsernameLabel" IsVisible="{Binding #RepositoryLabel.IsVisible}" Grid.Row="2" Grid.Column="0" Margin="0,0,8,6"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Text="{DynamicResource Text.TreeGit.Credentials.Username}"/>
        <TextBox x:Name="TxtUsername" IsVisible="{Binding #RepositoryLabel.IsVisible}" Grid.Row="2" Grid.Column="1"
                 Height="26" Margin="0,0,0,6" VerticalAlignment="Center" Watermark="{DynamicResource Text.TreeGit.Credentials.UsernameHint}"/>
        <TextBlock x:Name="PasswordLabel" IsVisible="{Binding #RepositoryLabel.IsVisible}" Grid.Row="3" Grid.Column="0" Margin="0,0,8,0"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <v:PasswordTextBox x:Name="TxtPassphrase" Grid.Row="3" Grid.Column="1"
                         MinWidth="300" Height="26" VerticalAlignment="Center"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         Watermark="{DynamicResource Text.TreeGit.Credentials.PasswordHint}"
                         Focusable="True" PasswordChar="*"
                         RevealPassword="{Binding #ToggleShowPassword.IsChecked, Mode=OneWay}">
          <TextBox.InnerRightContent>
            <ToggleButton x:Name="ToggleShowPassword"
                          Classes="toggle_untracked"
                          ToolTip.Tip="{DynamicResource Text.TreeGit.Credentials.TogglePassword}"
                          Width="26" Height="14"/>
          </TextBox.InnerRightContent>
        </v:PasswordTextBox>
        <v:GitHubTokenHelp x:Name="TokenHelp" Grid.Row="4" Grid.Column="1" IsVisible="False" Margin="0,6,0,0"/>
      </Grid>
      <TextBlock x:Name="ValidationMessage" Margin="16,0,16,12" MaxWidth="480" TextWrapping="Wrap" Foreground="IndianRed" IsVisible="False"/>
    </StackPanel>
    <Grid x:Name="VerificationOverlay" Grid.Row="0" IsVisible="False" IsHitTestVisible="False" MinHeight="100">
      <Border Background="{DynamicResource Brush.Window}" Opacity="0.8"/>
      <TextBlock x:Name="VerificationStatus" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Margin="20" TextWrapping="Wrap" TextAlignment="Center"/>
    </Grid>

      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
        <Button x:Name="ConfirmAuthentication" Classes="flat primary"
                Width="80"
                Content="{DynamicResource Text.Sure}"
                Click="EnterPassword"
                HotKey="Enter"/>
        <Button Classes="flat"
                Width="80"
              Margin="8,0,0,0"
                Content="{DynamicResource Text.Cancel}"
                Click="CloseWindow"/>
      </StackPanel>
    </Grid>
  </Grid>
</v:ChromelessWindow>
