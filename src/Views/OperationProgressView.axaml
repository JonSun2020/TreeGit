<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SourceGit.ViewModels" xmlns:v="using:SourceGit.Views"
             x:Class="SourceGit.Views.OperationProgressView" x:DataType="vm:Popup" Classes="dialog_selections">
  <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.WindowBorder}" BorderThickness="1" Padding="12">
    <Border.Styles>
      <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
    </Border.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding DialogTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <v:ActivityProgressBar Grid.Row="1" Height="16" VerticalAlignment="Center" Margin="0,0,12,0"
                             ReportedValue="{Binding OperationProgress}" IsRunning="{Binding CanCancelOperation}"/>
      <Button Grid.Row="1" Grid.Column="1" Name="CancelOperation" Classes="flat dialog_action dialog_cancel compact_dialog_action" Content="{DynamicResource Text.Cancel}"
              IsEnabled="{Binding CanCancelOperation}" MinWidth="60" Height="28" Padding="4,2" VerticalAlignment="Center" Click="OnCancelOperation"/>
      <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Name="ShowFullOperationOutput" IsChecked="{Binding ShowFullOutput, Mode=TwoWay}"
                Content="{DynamicResource Text.TreeGit.Operation.ShowFullOutput}" Margin="0,4,0,6"/>
      <ScrollViewer Grid.Row="3" Grid.ColumnSpan="2" Name="OperationOutputScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    MaxHeight="360" IsVisible="{Binding ShowFullOutput}">
        <v:OperationOutputView Name="OperationOutputText" Background="{DynamicResource Brush.Contents}" Padding="6" TextWrapping="NoWrap"/>
      </ScrollViewer>
      <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <SelectableTextBlock Text="{Binding OperationStage}" VerticalAlignment="Center" Classes.failed="{Binding OperationPhaseFailed}" TextWrapping="Wrap">
          <SelectableTextBlock.Styles><Style Selector="SelectableTextBlock.failed"><Setter Property="Foreground" Value="IndianRed"/></Style></SelectableTextBlock.Styles>
        </SelectableTextBlock>
        <Button Grid.Column="1" Name="CloseOperation" Classes="flat primary dialog_action dialog_close primary_close" Content="{DynamicResource Text.Close}" IsEnabled="{Binding CanCloseOperation}"
                MinWidth="80" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCloseOperation"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
