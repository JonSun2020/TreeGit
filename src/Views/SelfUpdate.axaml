<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:vm="using:SourceGit.ViewModels"
                    x:Class="SourceGit.Views.SelfUpdate"
                    x:DataType="vm:SelfUpdate"
                    x:Name="ThisControl"
                    Title="{DynamicResource Text.SelfUpdate.Title}"
                    Icon="/App.ico"
                    Width="600" Height="260" SizeToContent="Manual" MinWidth="440" MinHeight="240"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}" BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource Brush.Border0}" PointerPressed="BeginMoveWindow"/>
      <Path Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" Data="{StaticResource Icons.SoftwareUpdate}"/>
      <TextBlock Text="{DynamicResource Text.SelfUpdate.Title}" Classes="bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <v:CaptionButtons HorizontalAlignment="Right" IsCloseButtonOnly="True" IsEnabled="{Binding CanDismiss}"/>
    </Grid>
    <ScrollViewer x:Name="UpdateBodyScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,18,20,12" Spacing="12">
        <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding CurrentVersion}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"/>
          <TextBlock Text="{Binding NewVersion}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Link}" FontWeight="Bold"/>
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        <StackPanel IsVisible="{Binding ShowProgress}" Spacing="5">
          <v:ActivityProgressBar Height="6" ReportedValue="{Binding Progress}" IsRunning="{Binding IsWorking}"/>
          <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.FG2}"/>
        </StackPanel>
        <Border IsVisible="{Binding ShowNotes}" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border1}" BorderThickness="1" Padding="12">
          <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <v:RightAlignedWrapPanel Grid.Row="2" Margin="20,10,20,16" Grid.IsSharedSizeScope="True">
      <Grid HorizontalAlignment="Left" Margin="0,0,8,4" IsVisible="{Binding ShowManualDownload}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="UpdatePrimaryAction"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="ManualDownload" HorizontalAlignment="Stretch" Classes="flat primary dialog_action dialog_confirm" Content="{DynamicResource Text.SelfUpdate.Flow.Manual}" Click="GotoDownload"/>
      </Grid>
      <Grid Margin="0,0,0,4" IsVisible="{Binding CanAct}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="UpdatePrimaryAction"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="UpdateAction" HorizontalAlignment="Stretch" Classes="flat primary dialog_action dialog_confirm" Content="{Binding ActionText}" Click="OnAction"/>
      </Grid>
      <Button x:Name="BackgroundUpdate" Classes="flat dialog_action" Margin="8,0,0,4" Content="{DynamicResource Text.SelfUpdate.Flow.Background}" IsVisible="{Binding CanBackground}" Click="OnBackground"/>
      <Button x:Name="UpdateDismiss" Classes="flat dialog_action" Margin="8,0,0,4" Content="{Binding DismissText}" IsEnabled="{Binding CanDismiss}" Click="OnDismiss"/>
    </v:RightAlignedWrapPanel>
  </Grid>
</v:ChromelessWindow>
