<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:vm="using:SourceGit.ViewModels"
                    x:Class="SourceGit.Views.SelfUpdate"
                    x:DataType="vm:SelfUpdate"
                    x:Name="ThisControl"
                    Title="{DynamicResource Text.SelfUpdate.Title}"
                    Icon="/App.ico"
                    Width="600" Height="{Binding DesiredHeight}" MinWidth="440" MinHeight="240"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}" BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource Brush.Border0}" PointerPressed="BeginMoveWindow"/>
      <Path Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" Data="{StaticResource Icons.SoftwareUpdate}"/>
      <TextBlock Text="{DynamicResource Text.SelfUpdate.Title}" Classes="bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <v:CaptionButtons HorizontalAlignment="Right" IsCloseButtonOnly="True" IsEnabled="{Binding CanDismiss}"/>
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,18,20,12" Spacing="12">
        <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding CurrentVersion}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"/>
          <TextBlock Text="{Binding NewVersion}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Link}" FontWeight="Bold"/>
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        <StackPanel IsVisible="{Binding ShowProgress}" Spacing="5">
          <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"/>
          <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.FG2}"/>
        </StackPanel>
        <Border IsVisible="{Binding ShowNotes}" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border1}" BorderThickness="1" Padding="12">
          <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="20,10,20,16">
      <Button Grid.Column="0" HorizontalAlignment="Left" Classes="flat" Content="{DynamicResource Text.SelfUpdate.Flow.Manual}" IsVisible="{Binding ShowManualDownload}" Click="GotoDownload"/>
      <Button Grid.Column="1" Classes="flat primary" MinWidth="110" Height="32" Padding="12,0" Content="{Binding ActionText}" IsVisible="{Binding CanAct}" Click="OnAction"/>
      <Button Grid.Column="2" Classes="flat" MinWidth="90" Height="32" Padding="12,0" Margin="8,0,0,0" Content="{Binding DismissText}" IsEnabled="{Binding CanDismiss}" Click="OnDismiss"/>
    </Grid>
  </Grid>
</v:ChromelessWindow>
