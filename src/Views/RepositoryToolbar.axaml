<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns:v="using:SourceGit.Views" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:m="using:SourceGit.Models" xmlns:vm="using:SourceGit.ViewModels" xmlns:c="using:SourceGit.Converters" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:Class="SourceGit.Views.RepositoryToolbar" x:DataType="vm:Repository">
  <Grid ColumnDefinitions="*,Auto,0,Auto" Margin="8,0" Height="60" VerticalAlignment="Center">
    <Grid.Styles>
      <Style Selector="Button.icon_button">
        <Setter Property="Height" Value="54"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,4"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
      <Style Selector="Button.icon_button Path">
        <Setter Property="Fill" Value="{DynamicResource Brush.TreeGit.ToolbarIcon}"/>
      </Style>
      <Style Selector="Button.icon_button /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Opacity" Value="1"/></Style>
      <Style Selector="Button.icon_button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/></Style>
      <Style Selector="Button.icon_button:disabled Path"><Setter Property="Fill" Value="{DynamicResource Brush.FG2}"/></Style>
      <Style Selector="TextBlock.toolbar_label">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TreeGit.ToolbarLabel}"/>
        <Setter Property="FontSize" Value="12"/><Setter Property="MaxWidth" Value="60"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
      </Style>
    </Grid.Styles>
    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal"><Button Classes="icon_button" Width="58" Click="ShowWorkingCopy" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.WorkingCopy}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="M12,1 A11,11 0 1 1 11.99,1 M12,6 L12,18 M6,12 L18,12" Fill="Transparent" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" StrokeThickness="1.3" Stretch="Uniform" StrokeLineCap="Round" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/><TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Commit}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button><Button Classes="icon_button" Width="58" Tapped="Pull" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Pull}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Margin="0">
          <Path Width="22" Height="22" Data="M12,1 A11,11 0 1 1 11.99,1 M12,5 L12,18 M7,13 L12,18 17,13" Fill="Transparent" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" StrokeThickness="1.3" Stretch="Uniform" StrokeLineCap="Round"/>
          <Border Classes="sync_count" MinWidth="14" Height="14" Padding="3,0" CornerRadius="4" Background="{DynamicResource Brush.TreeGit.Selection}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-9,0" IsVisible="{Binding CurrentBranch?.Behind, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"><TextBlock Text="{Binding CurrentBranch.Behind.Count}" Foreground="{DynamicResource Brush.TreeGit.SelectionForeground}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Pull}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Tapped="Push">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Push}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Margin="0">
          <Path Width="22" Height="22" Data="M12,1 A11,11 0 1 1 11.99,1 M12,19 L12,6 M7,11 L12,6 17,11" Fill="Transparent" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" StrokeThickness="1.3" Stretch="Uniform" StrokeLineCap="Round"/>
          <Border Classes="sync_count" MinWidth="14" Height="14" Padding="3,0" CornerRadius="4" Background="{DynamicResource Brush.TreeGit.Selection}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-9,0" IsVisible="{Binding CurrentBranch?.Ahead, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"><TextBlock Text="{Binding CurrentBranch.Ahead.Count}" Foreground="{DynamicResource Brush.TreeGit.SelectionForeground}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Push}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Tapped="Fetch" Margin="0,0,24,0">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Fetch}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><v:ToolbarGlyph Width="24" Height="24" Kind="Fetch" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/><TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Fetch}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Command="{Binding CreateNewBranch}" HotKey="{OnPlatform Ctrl+B, macOS=⌘+B}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Repository.NewBranch}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+B, macOS=⌘+B}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="M5,5 A2.5,2.5 0 1 1 4.99,5 M5,10 L5,19 M5,19 A2.5,2.5 0 1 1 4.99,19 M5,17 C5,10 19,15 19,6 M19,1 A2.5,2.5 0 1 1 18.99,1" Fill="Transparent" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" StrokeThickness="1.3" Stretch="Uniform" StrokeLineCap="Round" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Branch}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Click="OpenMergeMenu" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.Toolbar.Merge}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="M5,2 A2.5,2.5 0 1 1 4.99,2 M5,7 L5,19 M5,19 A2.5,2.5 0 1 1 4.99,19 M18,2 A2.5,2.5 0 1 1 17.99,2 M18,7 C18,12 5,12 5,17" Fill="Transparent" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" StrokeThickness="1.3" Stretch="Uniform" StrokeLineCap="Round" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/><TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Merge}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button><Button Classes="icon_button" Width="58" Tapped="StashAll" IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Stash}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="M1,3 L23,3 23,21 1,21 Z M12,6 A2.5,2.5 0 1 1 11.99,6 M6,13 A2.5,2.5 0 1 1 5.99,13 M18,13 A2.5,2.5 0 1 1 17.99,13" Fill="Transparent" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" StrokeThickness="1.3" Stretch="Uniform" StrokeLineCap="Round" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Stash}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Click="OpenDiscard" IsVisible="{Binding !IsBare}" ToolTip.Tip="丢弃更改"><Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><v:ToolbarGlyph Width="24" Height="24" Kind="Discard" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/><TextBlock Classes="toolbar_label" Text="丢弃" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button><Button Classes="icon_button" Width="58" Command="{Binding CreateNewTag}" ToolTip.Tip="{DynamicResource Text.Toolbar.Tag}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="M2,2 L12,2 23,13 13,23 2,12 Z M7,5 A2,2 0 1 1 6.99,5" Fill="Transparent" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" StrokeThickness="1.3" Stretch="Uniform" StrokeLineCap="Round" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/><TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Tag}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button></StackPanel>

    </ScrollViewer>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0"><Button Classes="icon_button" Width="82" Click="OpenTerminalDirect" ToolTip.Tip="终端"><Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="M1,3 L23,3 23,21 1,21 Z M5,8 L9,12 5,16 M12,16 L19,16" Fill="Transparent" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" StrokeThickness="1.3" Stretch="Uniform" StrokeLineCap="Round" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/><TextBlock Classes="toolbar_label" Text="命令行模式" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button><Button Classes="icon_button" Width="82" Click="OpenExplorerDirect" ToolTip.Tip="浏览"><Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="M1,7 L10,7 12,10 23,10 23,21 1,21 Z M3,7 L3,3 10,3 12,6 21,6 21,10" Fill="Transparent" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" StrokeThickness="1.3" Stretch="Uniform" StrokeLineCap="Round" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/><TextBlock Classes="toolbar_label" Text="资源管理器" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button><Button Classes="icon_button" Width="58" Click="OpenSettingsDirect" ToolTip.Tip="设置"><Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="{StaticResource Icons.Settings}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/><TextBlock Classes="toolbar_label" Text="设置" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button><Button Classes="icon_button" Width="0" ToolTip.Tip="仓库工具" IsVisible="False"><Button.Flyout><Flyout><StackPanel Orientation="Horizontal"><Button Classes="icon_button" Width="58" Click="OpenWithExternalTools" ToolTip.Tip="{DynamicResource Text.Repository.OpenWithExternalTools}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="{StaticResource Icons.OpenWith}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Tools}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Click="OpenGitLogs" ToolTip.Tip="{DynamicResource Text.Repository.ViewLogs}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Margin="0" Data="{StaticResource Icons.Logs}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Log}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Click="OpenStatistics" ToolTip.Tip="{DynamicResource Text.Repository.Statistics}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Margin="0" Data="{StaticResource Icons.Statistics}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Statistics}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button></StackPanel></Flyout></Button.Flyout><Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="{StaticResource Icons.Tool}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/><TextBlock Classes="toolbar_label" Text="工具" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button><Button Classes="icon_button" Width="0" ToolTip.Tip="更多操作" IsVisible="False"><Button.Flyout><Flyout><StackPanel Orientation="Horizontal"><Button Classes="icon_button" Width="58" Command="{Binding ApplyPatch}" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.Apply.Title}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="{StaticResource Icons.ApplyPatch}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Patch}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Click="OpenGitLFSMenu" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.GitLFS}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="{StaticResource Icons.LFS}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.GitLFS}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Click="StartBisect" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.Bisect}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="{StaticResource Icons.Bisect}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Bisect}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Click="OpenCustomActionMenu" ToolTip.Tip="{DynamicResource Text.Repository.CustomActions}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="{StaticResource Icons.Action}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Actions}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Click="Cleanup" ToolTip.Tip="{DynamicResource Text.Repository.Clean}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Margin="0" Data="{StaticResource Icons.Clean}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.Clean}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Grid MaxWidth="135" HorizontalAlignment="Right" RowDefinitions="*,18" ColumnDefinitions="Auto,*,32,40">
      <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Margin="8,0" FontSize="10" Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Right" Text="{Binding McpActivity}" TextTrimming="CharacterEllipsis"/>
      <Path Grid.Column="0" Width="13" Height="13" Margin="18,0,0,0" Data="{StaticResource Icons.Branch}"/>

      <Border Grid.Column="1" Margin="6,0,0,0" Background="Transparent" ToolTip.Tip="{Binding CurrentBranch?.Name, TargetNullValue='--', Mode=OneWay}">
        <TextBlock Text="{Binding CurrentBranch?.Name, TargetNullValue='--', Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
      </Border>

      <Button Grid.Column="2" Classes="icon_button" Width="32" Click="NavigateToHead" ToolTip.Tip="{DynamicResource Text.Repository.NavigateToCurrentHead}">
        <Path Width="13" Height="13" Margin="0,2,0,0" Data="{StaticResource Icons.Target}"/>
      </Button>
      <Button Grid.Column="3" Classes="icon_button" Width="36" Click="OpenRepositoryCredentials" ToolTip.Tip="仓库账号与密码">
        <Path Width="18" Height="18" Data="{StaticResource Icons.Password}"/>
      </Button>
    </Grid>
  <Button Classes="icon_button" Width="88" Command="{Binding AddSubmodule}" IsVisible="{Binding !IsBare}"><StackPanel Orientation="Vertical" VerticalAlignment="Center"><Path Width="22" Height="22" Data="{StaticResource Icons.Submodule.Add}"/><TextBlock Classes="toolbar_label" Text="添加子模块"/></StackPanel></Button><Button Classes="icon_button" Width="88" Command="{Binding AddWorktree}" IsVisible="{Binding !IsBare}"><StackPanel Orientation="Vertical" VerticalAlignment="Center"><Path Width="22" Height="22" Data="{StaticResource Icons.Worktree.Add}"/><TextBlock Classes="toolbar_label" Text="添加工作树"/></StackPanel></Button><Button Classes="icon_button" Width="58" Click="OpenGitFlowMenu" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.GitFlow}">
        <Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="M5,2 A2.5,2.5 0 1 1 4.99,2 M5,7 L5,19 M5,19 A2.5,2.5 0 1 1 4.99,19 M19,2 A2.5,2.5 0 1 1 18.99,2 M19,7 L19,19 M19,19 A2.5,2.5 0 1 1 18.99,19 M5,14 C5,8 19,14 19,8" Fill="Transparent" Stroke="{DynamicResource Brush.TreeGit.ToolbarOutline}" StrokeThickness="1.3" Stretch="Uniform" StrokeLineCap="Round" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Toolbar.GitFlow}" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid></Button><Button Classes="icon_button" Width="58" Click="OpenRemotesDirect" ToolTip.Tip="远端"><Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="{StaticResource Icons.Remotes}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/><TextBlock Classes="toolbar_label" Text="远端" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button></StackPanel></Flyout></Button.Flyout><Grid RowDefinitions="24,5,20" Height="49" Margin="0,3,0,0" VerticalAlignment="Center"><Path Width="22" Height="22" Data="{StaticResource Icons.Menu}" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/><TextBlock Classes="toolbar_label" Text="更多" Grid.Row="2" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button></StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
    </StackPanel>

    </Grid>
</UserControl>
