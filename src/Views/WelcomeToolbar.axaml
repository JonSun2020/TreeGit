<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.WelcomeToolbar"
             x:DataType="vm:Welcome">
  <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0">
    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <Button Classes="icon_button" Width="72" Height="62" Command="{Binding Clone}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.Clone}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+R, macOS=⌘+R}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip><StackPanel Orientation="Vertical"><Path Width="22" Height="22" Data="{StaticResource Icons.Clone}" Margin="0,4,0,0"/><TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Text="{DynamicResource Text.Toolbar.Clone}"/></StackPanel></Button>

      <Button Classes="icon_button" Width="72" Height="62" Command="{Binding OpenLocalRepository}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.OpenOrInit}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+L, macOS=⌘+L}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip><StackPanel Orientation="Vertical"><Path Width="22" Height="22" Data="{StaticResource Icons.Folder.Open}" Margin="0,2,0,0"/><TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Text="{DynamicResource Text.Toolbar.Open}"/></StackPanel></Button>

      <Button Classes="icon_button" Width="72" Height="62" Command="{Binding OpenTerminal}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.OpenTerminal}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+`, macOS=Λ+`}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip><StackPanel Orientation="Vertical"><Path Width="22" Height="22" Data="{StaticResource Icons.Terminal}"/><TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Text="{DynamicResource Text.Toolbar.Terminal}"/></StackPanel></Button>
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button Classes="icon_button" Width="72" Height="62" Command="{Binding AddRootNode}" ToolTip.Tip="{DynamicResource Text.Welcome.AddRootFolder}"><StackPanel Orientation="Vertical"><Path Width="22" Height="22" Margin="0,2,0,0" Data="{StaticResource Icons.Folder.Add}"/><TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Text="{DynamicResource Text.Toolbar.Groups}"/></StackPanel></Button>

      <Button Classes="icon_button" Width="72" Height="62" Command="{Binding ScanDefaultCloneDir}" ToolTip.Tip="{DynamicResource Text.Welcome.ScanDefaultCloneDir}"><StackPanel Orientation="Vertical"><Path Width="22" Height="22" Data="{StaticResource Icons.Scan}"/><TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Text="{DynamicResource Text.Toolbar.Scan}"/></StackPanel></Button>
    </StackPanel>
  </Grid>
</UserControl>
