<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:m="using:SourceGit.Models" xmlns:v="using:SourceGit.Views" xmlns:vm="using:SourceGit.ViewModels" xmlns:c="using:SourceGit.Converters" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:Class="SourceGit.Views.LauncherPage" x:DataType="vm:LauncherPage">
  <Grid RowDefinitions="60,*" Background="{DynamicResource Brush.ToolBar}">
    <!-- ToolBar -->
    <Border Grid.Row="0" Background="Transparent" PointerPressed="OnToolBarPointerPressed">
      <ContentControl Content="{Binding Data}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:Welcome">
            <v:WelcomeToolbar/>
          </DataTemplate>

          <DataTemplate DataType="vm:Repository">
            <v:RepositoryToolbar/>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>

    <!-- Body -->
    <Border Grid.Row="1">
      <ContentControl Content="{Binding Data}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:RepositoryLoading">
            <TextBlock Text="{Binding Message}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </DataTemplate>
          <DataTemplate DataType="vm:Welcome">
            <v:Welcome Margin="4,0,4,4" CornerRadius="0" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border0}" Background="{DynamicResource Brush.Window}"/>
          </DataTemplate>

          <DataTemplate DataType="vm:Repository">
            <v:Repository>
              <v:Repository.IsNormalSidebarVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <Binding Path="IsDashboardVisible"/>
                  <Binding Path="IsStashesVisible"/>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsWorkingCopyVisible"/>
                    <Binding Source="{x:Static vm:Preferences.Instance}" Path="Layout.IsSidebarCollapsedInLocalChanges" Converter="{x:Static BoolConverters.Not}"/>
                  </MultiBinding>
                </MultiBinding>
              </v:Repository.IsNormalSidebarVisible>
            </v:Repository>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>

    <!-- Floating -->
    <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="PopupArea" ClipToBounds="True">
      <Grid.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="Popup" Converter="{x:Static ObjectConverters.IsNotNull}"/>
          <Binding Path="Notifications.Count" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
        </MultiBinding>
      </Grid.IsVisible>

      <Border Background="#66000000" PointerPressed="OnMaskClicked" IsVisible="{Binding Popup, Converter={x:Static ObjectConverters.IsNotNull}}"/>

      <Grid RowDefinitions="*,Auto,Auto" Classes="popup_frame" Classes.dialog_open="{Binding Popup, Converter={x:Static ObjectConverters.IsNotNull}}" MaxWidth="560" MaxHeight="{Binding #PopupArea.Bounds.Height}" HorizontalAlignment="Stretch">
        <Grid.Styles>
          <Style Selector="Grid.popup_frame"><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,60,0,0"/></Style>
          <Style Selector="Grid.popup_frame.dialog_open"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0"/></Style>
        </Grid.Styles>
        <!-- Popup -->
        <Grid Grid.Row="0" Margin="6,8,6,8" ZIndex="1">
          <Border x:Name="PopupDialogSurface" Classes="dialog_selections" Background="Transparent"
                  PointerPressed="OnPopupDragPressed" PointerMoved="OnPopupDragMoved" PointerReleased="OnPopupDragReleased" PointerCaptureLost="OnPopupDragCaptureLost">
            <Border.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="Popup" Converter="{x:Static ObjectConverters.IsNotNull}"/><Binding Path="Popup.OperationPanelVisible" Converter="{x:Static BoolConverters.Not}"/></MultiBinding></Border.IsVisible>
            <Border Background="{DynamicResource Brush.Window}" BorderThickness="1" BorderBrush="{DynamicResource Brush.WindowBorder}" CornerRadius="0">
              <ContentControl x:Name="PopupPanel" Content="{Binding Popup}" KeyboardNavigation.TabNavigation="Cycle">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:Popup">
                    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                      <Border x:Name="PopupDragHandle" Grid.Row="0" Height="28" Cursor="SizeAll" Background="{DynamicResource Brush.TitleBar}"
                              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}" IsVisible="{Binding UsesDialogTitle}">
                        <Grid>
                          <ContentControl Content="{Binding}" Width="14" Margin="10,0,0,0" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsHitTestVisible="False">
                            <ContentControl.DataTemplates>
                              <DataTemplate DataType="vm:Clone"><Path Width="14" MaxHeight="14" Data="{StaticResource Icons.Clone}"/></DataTemplate>
                              <DataTemplate DataType="vm:OpenLocalRepository"><Path Width="14" MaxHeight="14" Data="{StaticResource Icons.Folder.Open}"/></DataTemplate>
                              <DataTemplate DataType="vm:CreateRepository"><Path Width="14" MaxHeight="14" Data="{StaticResource Icons.Init}"/></DataTemplate>
                              <DataTemplate DataType="vm:CherryPick"><Path Width="14" MaxHeight="14" Data="{StaticResource Icons.CherryPick}"/></DataTemplate>
                              <DataTemplate DataType="vm:Revert"><Path Width="14" MaxHeight="14" Data="{StaticResource Icons.Undo}"/></DataTemplate>
                              <DataTemplate DataType="vm:CreateGroup"><Path Width="14" MaxHeight="14" Data="{StaticResource Icons.Folder.Add}"/></DataTemplate>
                              <DataTemplate DataType="vm:ScanRepositories"><Path Width="14" MaxHeight="14" Data="{StaticResource Icons.Scan}"/></DataTemplate>
                              <DataTemplate DataType="vm:Popup"><Path Width="14" MaxHeight="14" Data="{StaticResource Icons.Repositories}"/></DataTemplate>
                            </ContentControl.DataTemplates>
                          </ContentControl>
                          <TextBlock Text="{Binding DialogTitle}" Foreground="{DynamicResource Brush.FG1}" FontWeight="Bold" Margin="40,0"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                          <Button x:Name="ClosePopup" Classes="caption_button" Width="46" Height="28" HorizontalAlignment="Right" Cursor="Arrow"
                                  Click="OnPopupCancel" IsEnabled="{Binding !InProgress}" ToolTip.Tip="{DynamicResource Text.Close}">
                            <Path Width="9" Height="9" Data="{StaticResource Icons.Window.Close}"/>
                          </Button>
                        </Grid>
                      </Border>
                      <!-- Popup Widget -->
                      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <ContentControl Classes.captioned="{Binding UsesDialogTitle}" Margin="8,8,8,8" Content="{Binding}" IsHitTestVisible="{Binding InProgress, Converter={x:Static BoolConverters.Not}}">
                        <ContentControl.Styles><Style Selector="ContentControl.captioned StackPanel.popup_heading, ContentControl.captioned TextBlock.popup_heading"><Setter Property="IsVisible" Value="False"/></Style></ContentControl.Styles>
                        <ContentControl.DataTemplates>
                          <v:PopupDataTemplates/>
                        </ContentControl.DataTemplates>
                      </ContentControl>
                      </ScrollViewer>

                      <!-- Options -->
                      <StackPanel Grid.Row="2" Margin="8,8,8,8" Height="32" Orientation="Horizontal" HorizontalAlignment="Right" IsVisible="{Binding InProgress, Converter={x:Static BoolConverters.Not}}">
                        <Button Width="0" Height="0" Click="OnPopupSureByHotKey" HotKey="Enter" Focusable="False"/>
                        <Button x:Name="ConfirmPopup" Classes="flat primary" Width="100" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="{DynamicResource Text.Sure}" Click="OnPopupSure" ToolTip.Tip="Enter"/>
                        <Button x:Name="CancelPopup" Classes="flat" Width="100" Height="28" Margin="8,0,0,0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="{DynamicResource Text.Cancel}" Click="OnPopupCancel" ToolTip.Tip="ESC"/>
                      </StackPanel>

                      <!-- Running -->
                      <ScrollViewer Grid.Row="3" MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowStatus}">
                        <v:PopupRunningStatus Margin="12,8" Focusable="False" Description="{Binding StatusDescription}" IsHitTestVisible="False" Classes.failed="{Binding OperationPhaseFailed}">
                          <v:PopupRunningStatus.Styles><Style Selector="v|PopupRunningStatus.failed TextBlock"><Setter Property="Foreground" Value="IndianRed"/></Style></v:PopupRunningStatus.Styles>
                        </v:PopupRunningStatus>
                      </ScrollViewer>

                      <!-- Terminate -->
                      <Button Grid.Row="4" Classes="flat" Height="28" Margin="0,0,0,8" Padding="16,0" HorizontalAlignment="Center" Content="{DynamicResource Text.Terminate}" Click="OnPopupTerminate">
                        <Button.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="InProgress" Mode="OneWay"/>
                            <Binding Path="CanTerminate" Mode="OneWay"/>
                          </MultiBinding>
                        </Button.IsVisible>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </Border>
          </Border>

        </Grid>
        
        <!-- Notifications Clear Button -->
        <Button Grid.Row="1" Classes="flat primary" Margin="0,8,0,0" Padding="16,0" Height="24" CornerRadius="12" HorizontalAlignment="Center" Command="{Binding ClearNotifications}" IsVisible="{Binding Notifications.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="14" Height="14" Data="{StaticResource Icons.ClearNotifications}" Fill="White"/>
            <TextBlock Margin="4,0,0,0" Text="{DynamicResource Text.Repository.Notifications.Clear}" Foreground="White"/>
          </StackPanel>
        </Button>

        <!-- Notifications -->
        <ScrollViewer Grid.Row="2" VerticalAlignment="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ScrollViewer.MaxHeight>
            <MultiBinding Converter="{x:Static c:DoubleConverters.NotificationAreaHeight}">
              <Binding Path="#PopupArea.Bounds.Height"/>
              <Binding Path="Popup" Converter="{x:Static ObjectConverters.IsNotNull}"/>
            </MultiBinding>
          </ScrollViewer.MaxHeight>
          <ItemsControl ItemsSource="{Binding Notifications}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="m:Notification">
                <Border Margin="6" HorizontalAlignment="Stretch" VerticalAlignment="Top" Effect="drop-shadow(0 0 8 #80000000)">
                  <Border Padding="8" CornerRadius="6" Background="{DynamicResource Brush.Popup}" BorderThickness="1" BorderBrush="{DynamicResource Brush.PopupBorder}">
                    <Grid RowDefinitions="26,Auto">
                      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,0">
                        <Path Grid.Column="0" Width="14" Height="14" Data="{StaticResource Icons.Error}" Fill="Red" IsVisible="{Binding IsError}"/>
                        <Path Grid.Column="0" Width="14" Height="14" Data="{StaticResource Icons.Info}" Fill="Green" IsVisible="{Binding !IsError}"/>
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontWeight="Bold" FontSize="14" Text="{DynamicResource Text.Launcher.Error}" IsVisible="{Binding IsError}"/>
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontWeight="Bold" FontSize="14" Text="{DynamicResource Text.Launcher.Info}" IsVisible="{Binding !IsError}"/>
                        <v:CopyButton Grid.Column="2" Width="16" Height="16" CopyText="{Binding Message}" ToolTip.Tip="{DynamicResource Text.Copy}"/>
                        <Button Grid.Column="3" Classes="icon_button" Width="16" Height="16" Margin="8,0,0,0" Click="OnDismissNotification">
                          <Path Width="10" Height="10" Data="{StaticResource Icons.Close}"/>
                        </Button>
                      </Grid>

                      <v:CommandLogContentPresenter Grid.Row="1" Margin="8" Padding="2" MaxHeight="200" Log="{Binding Message, Mode=OneWay}" WordWrap="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                  </Border>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
      <ContentControl x:Name="OperationPanelSurface" Content="{Binding Popup}" IsVisible="{Binding Popup.OperationPanelVisible, FallbackValue=False}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="8,72,8,8" MaxHeight="{Binding #PopupArea.Bounds.Height}" ZIndex="10">
        <ContentControl.DataTemplates><DataTemplate DataType="vm:Popup"><v:OperationProgressView/></DataTemplate></ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
  </Grid>
</UserControl>
