      <Color x:Key="Color.FlatButton.FloatingBorder">#FF898989</Color>
      <Color x:Key="Color.FG1">#FF333333</Color>
      <Color x:Key="Color.FG2">#FF666666</Color>
      <Color x:Key="Color.Diff.EmptyBG">#10000000</Color>
      <Color x:Key="Color.Diff.AddedBG">#80BFE6C1</Color>
      <Color x:Key="Color.Diff.DeletedBG">#80FF9797</Color>
      <Color x:Key="Color.Diff.AddedHighlight">#A7E1A7</Color>
      <Color x:Key="Color.Diff.DeletedHighlight">#F19B9D</Color>
      <Color x:Key="Color.Diff.BlockBorderHighlight">DarkCyan</Color>
      <Color x:Key="Color.Link">#FF195F69</Color>
      <Color x:Key="Color.InlineCode">#FFE4E4E4</Color>
      <Color x:Key="Color.InlineCodeFG">Black</Color>
      <Color x:Key="Color.SubPanel">#FFFAFBFC</Color>
    <Color x:Key="Color.TreeGit.ChromeForeground">#FFF3FCF7</Color><Color x:Key="Color.TreeGit.ToolbarOutline">#FF286D76</Color><Color x:Key="Color.TreeGit.TabInactive">#FFD2DDE0</Color><Color x:Key="Color.TreeGit.TabActive">#FFFFFFFF</Color><Color x:Key="Color.TreeGit.TabActiveBorder">#FF22B99A</Color></ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="SystemAccentColor">#FF68C1CB</Color>
      <Color x:Key="SystemListLowColor">#FF234249</Color>
      <Color x:Key="Color.TreeGit.Chrome">#FF103F47</Color>
      <Color x:Key="Color.TreeGit.ChromeHover">#FF205D64</Color>
      <Color x:Key="Color.TreeGit.ToolbarIconTop">#FF93D1D8</Color>
