    <Color x:Key="Color.TreeGit.ChromeForeground">#FFF3FCF7</Color><Color x:Key="Color.TreeGit.ToolbarOutline">#FF79BDC5</Color><Color x:Key="Color.TreeGit.TabInactive">#FF34474D</Color><Color x:Key="Color.TreeGit.TabActive">#FF49646C</Color><Color x:Key="Color.TreeGit.TabActiveBorder">#FF22B99A</Color></ResourceDictionary>
  <ResourceDictionary x:Key="{x:Static m:TreeGitThemes.SourceTree}">
