      <Color x:Key="Color.Border0">#FFDFE1E6</Color>
      <Color x:Key="Color.Border1">#FFB3BAC5</Color>
      <Color x:Key="Color.Border2">#FFDFE1E6</Color>
      <Color x:Key="Color.FlatButton.Background">#FFF8F8F8</Color>
