<ResourceDictionary xmlns:m="using:SourceGit.Models" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="SystemAccentColor">#FF195F69</Color>
      <Color x:Key="SystemListLowColor">#FFDDECEF</Color>
      <Color x:Key="Color.TreeGit.Chrome">#FF103F47</Color>
      <Color x:Key="Color.TreeGit.ChromeHover">#FF205D64</Color>
      <Color x:Key="Color.TreeGit.ToolbarIconTop">#FF50929B</Color>
      <Color x:Key="Color.TreeGit.ToolbarIconBottom">#FF195F69</Color>
      <Color x:Key="Color.TreeGit.ToolbarLabel">#FF284F55</Color>
      <Color x:Key="Color.Window">#FFF4F5F7</Color>
      <Color x:Key="Color.WindowBorder">#FFB3BAC5</Color>
      <Color x:Key="Color.TitleBar">#FFEBECF0</Color>
      <Color x:Key="Color.ToolBar">#FFF4F5F7</Color>
      <Color x:Key="Color.Popup">#FFFAFAFA</Color>
      <Color x:Key="Color.PopupBorder">#FFDFE1E6</Color>
      <Color x:Key="Color.Contents">#FFFFFFFF</Color>
      <Color x:Key="Color.Badge">#FFDDECEF</Color>
      <Color x:Key="Color.BadgeFG">#FF103F47</Color>
      <Color x:Key="Color.Conflict">#FF836C2E</Color>
