  <!-- TreeGit consistent operation and preference controls -->
  <x:String x:Key="Text.Stash.After.Remove" xml:space="preserve">貯藏後移除本地修改</x:String>
  <x:String x:Key="Text.Stash.After.Remove.Description" xml:space="preserve">修改已儲存到貯藏，本地恢復到修改前。</x:String>
